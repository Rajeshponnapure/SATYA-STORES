# ==============================================================================
# SATYA STORES — 100% FREE ZERO-BUDGET ENVIRONMENT CONFIGURATION
# ==============================================================================
# By default, Satya Stores uses the built-in zero-budget persistent database
# located at `data/database.json`. It works 100% out-of-the-box with ZERO accounts.
#
# If you want to use Supabase (100% Free Forever Tier):
# 1. Sign up at https://supabase.com (Free, no credit card required)
# 2. Create a new free project
# 3. Paste the contents of `supabase-schema.sql` into the Supabase SQL Editor and click RUN
# 4. Copy your Project URL & Anon Key from Project Settings > API and paste below:
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
