# ==============================================================================
# SATYA STORES — BACKEND CONFIGURATION (.env)
# Port: 5000
# ==============================================================================

PORT=5000
FRONTEND_URL=http://localhost:3000

# Required in production. Generate at least 32 random characters; never expose it to the browser.
SESSION_SECRET=
# Recommended: a different 32+ character secret used only to encrypt Google Authenticator secrets in Supabase.
# If omitted, SESSION_SECRET is used as a safe compatibility fallback.
TOTP_ENCRYPTION_KEY=

# Temporary owner-only setup key. Generate 32+ random characters, add it only
# while registering/replacing the shared Authenticator or Admin PIN, then
# remove it from Render to disable the super-admin setup actions.
ADMIN_SECURITY_SETUP_KEY=

# Required in production. These are server-only values from Supabase Project Settings → API Keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# The exact name of an existing public Supabase Storage bucket, for example product-images.
SUPABASE_STORAGE_BUCKET=

# Test or live Razorpay keys. Never place either secret in Vercel.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional for a single Render instance; required before horizontal scaling.
REDIS_URL=

