# ==============================================================================
# SATYA STORES — BACKEND CONFIGURATION (.env)
# Port: 5000
# ==============================================================================

PORT=5000
FRONTEND_URL=http://localhost:3000

# Required for admin API sessions in production; use a cryptographically random secret.
# Leave unset for local development (a new in-memory secret is generated each launch).
ADMIN_SESSION_SECRET=

# Zero-budget local JSON database operates out-of-the-box at `data/database.json`
# If you wish to connect Supabase Free Tier, uncomment and fill in:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

