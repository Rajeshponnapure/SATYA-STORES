PORT=3000
# Backend API connection endpoint (Express server running on Port 5000)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Production only: a server-side, unguessable private entry value for the
# admin portal. Do not use the NEXT_PUBLIC_ prefix and do not commit its value.
ADMIN_PORTAL_SLUG=

